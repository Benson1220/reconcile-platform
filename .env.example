# setup 會建立含隨機密碼的 .env；不要提交 .env 到 Git。
DATABASE_URL=postgresql://reconcile_app:REPLACE_ME@127.0.0.1:55432/reconcile
# 可選：準備金鑰後，建議用 python -m scripts.configure_ai 在本機設定。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 目前使用本機規則式摘要，外部模型預設停用。
OPENAI_SUMMARY_ENABLED=false
# 本機完整功能維持 false；雲端公開展示設為 true。
DEMO_READ_ONLY=false
# 啟用帳號與權限時，在啟動指令前加 AUTH_REQUIRED=true。
